---
import BaseLayout from '../../layouts/BaseLayout.astro';
import posts from '../../data/substack-posts.json';

const sortedPosts = [...posts].sort((a, b) => new Date(b.publishedAt) - new Date(a.publishedAt));
const dateLabel = (value) => value ? new Date(value).toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' }) : 'DATE NOT AVAILABLE';
---
<BaseLayout current="Writing" title="Writing Archive" description="All public articles published on Koami’s Substack, collected in one personal archive.">
  <div class="eyebrow">PUBLIC WRITING · SUBSTACK ARCHIVE</div>
  <h1>Writing Archive</h1>
  <p class="lede">A complete archive of public essays and ideas published on Substack. Substack remains the original place of publication; this page keeps a searchable home for the writing.</p>
  <p class="small-note"><strong>{sortedPosts.length} published posts</strong> · <a href="https://koami.substack.com" target="_blank" rel="noreferrer">Visit Koami’s Substack ↗</a> · <a href="https://koami.substack.com/feed" target="_blank" rel="noreferrer">RSS feed ↗</a></p>
  {sortedPosts.length ? sortedPosts.map((post) => (
    <article class="entry">
      <div class="entry-date">{dateLabel(post.publishedAt)}</div>
      <div>
        <a class="entry-title" href={"/writing/" + post.slug + "/"}>{post.title}</a>
        {post.description && <p>{post.description}</p>}
        <p class="small-note"><a href={post.url} target="_blank" rel="noreferrer">Read the original on Substack ↗</a></p>
      </div>
    </article>
  )) : <p class="small-note">No public posts were found in the Substack archive yet.</p>}
  <p class="small-note" style="margin-top:36px">This archive reflects the latest Substack data export. Unpublished drafts are intentionally excluded; Substack currently blocks automated RSS requests from the hosted sync runner, so newer posts may require a fresh export.</p>
</BaseLayout>
